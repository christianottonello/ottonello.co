---
import Base from '../layouts/Base.astro';
import Face from '../components/Face.astro';
---
<Base>
  <main class="page">
    <div>
      <p class="lead">Hola, I'm Otto, a designer and creative director in Buenos Aires, Argentina. I run <a href="https://otrostudio.co">Otro</a>, an independent product studio for software companies.</p>
      <p>Previously, I was Head of Design at DEPT<sup>®</sup> in Latin America, where I went from being the only designer to leading a team of thirty across three countries, working with global brands and early-stage startups.</p>
      <p>I dig into problems before solving them, because understanding what's actually going on is what makes the answer feel obvious later.</p>
      <p>When I'm not working, you'll find me <span class="w">running</span>, <span class="w">seeing my favorite bands live</span>, taking <span class="w">photos</span>, or <span class="w">screenshotting</span> more things than I'll ever look at again.</p>
      <p>Whether you're building something or finding your way in design, I'm happy to help: <a href="mailto:christian@ottonello.co">christian@ottonello.co</a></p>
      <ul class="links">
        <li><a href="https://twitter.com/ottonello">Twitter</a></li>
        <li><a href="https://www.linkedin.com/in/christianottonello">LinkedIn</a></li>
      </ul>
    </div>
    <div class="face"><Face /></div>
  </main>
</Base>

<script>
  const f = document.querySelector<HTMLElement>('.face');
  if (f && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    addEventListener('mousemove', (e) => {
      if (innerWidth <= 900) return;
      const r = f.getBoundingClientRect();
      const cx = r.left + r.width * 0.45, cy = r.top + r.height * 0.6;
      const dx = (e.clientX - cx) / innerWidth, dy = (e.clientY - cy) / innerHeight;
      f.style.transform = `rotate(${dx * 5}deg) translate(${dx * 10}px, ${dy * 8}px)`;
    }, { passive: true });
  }
</script>
