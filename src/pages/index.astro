---
import Base from '../layouts/Base.astro';
import Face from '../components/Face.astro';
import OtroMark from '../components/OtroMark.astro';
const sets = {
  running: ['/img/running-1.webp', '/img/running-2.webp', '/img/running-3.webp', '/img/running-4.webp', '/img/running-5.webp', '/img/running-6.webp', '/img/running-7.webp'],
  photos: ['/img/photos-1.webp', '/img/photos-2.webp', '/img/photos-3.webp', '/img/photos-4.webp', '/img/photos-5.webp', '/img/photos-6.webp', '/img/photos-7.webp', '/img/photos-8.webp'],
  bands: ['/img/bands-1.webp', '/img/bands-2.webp', '/img/bands-3.webp', '/img/bands-4.webp', '/img/bands-5.webp', '/img/bands-6.webp', '/img/bands-7.webp'],
};
---
<Base>
  <main class="page">
    <div>
      <p class="lead">Hola, I'm Otto, a designer and creative director in Buenos Aires, Argentina. I run <a href="https://otrostudio.co" class="otro" target="_blank" rel="noopener"><OtroMark />Otro</a>, an independent product studio for software companies.</p>
      <p>Previously, I was Head of Design at DEPT<sup>®</sup> in Latin America, where I went from being the only designer to leading a team of thirty across three countries, working with global brands and early-stage startups.</p>
      <p>I dig into problems before solving them, because understanding what's actually going on is what makes the answer feel obvious later.</p>
      <p>When I'm not working, you'll find me seeing my <span class="w" data-set="bands">favorite bands</span> live, <span class="w" data-set="running">running</span>, <span class="w" data-set="photos">shooting photos</span>, or screenshotting more things than I'll ever look at again.</p>
      <p>Whether you're building something or finding your way in design, I'm happy to help: <a href="mailto:christian@ottonello.co" class="mail" data-mail="christian@ottonello.co">christian@ottonello.co</a></p>
      <ul class="links">
        <li><a href="https://twitter.com/ottonello" target="_blank" rel="noopener">Twitter</a></li>
        <li><a href="https://www.linkedin.com/in/christianottonello" target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
    <div class="face"><Face /></div>
  </main>
  <div class="polaroid" id="polaroid" aria-hidden="true"><img alt="" /></div>
  <script type="application/json" id="sets" set:html={JSON.stringify(sets)} />
</Base>

<script>
  // Face follows the cursor
  const f = document.querySelector<HTMLElement>('.face');
  const canHover = matchMedia('(hover: hover)').matches;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (f && canHover && !reduced) {
    addEventListener('mousemove', (e) => {
      if (innerWidth <= 900) return;
      const r = f.getBoundingClientRect();
      const cx = r.left + r.width * 0.45, cy = r.top + r.height * 0.6;
      const dx = (e.clientX - cx) / innerWidth, dy = (e.clientY - cy) / innerHeight;
      f.style.transform = `rotate(${dx * 5}deg) translate(${dx * 10}px, ${dy * 8}px)`;
    }, { passive: true });
  }

  // Polaroids on the hobby words: position across the word picks the photo
  const sets: Record<string, string[]> = JSON.parse(document.getElementById('sets')!.textContent!);
  const pol = document.getElementById('polaroid') as HTMLElement;
  const img = pol.querySelector('img') as HTMLImageElement;
  Object.values(sets).flat().forEach((src) => { const i = new Image(); i.src = src; });

  let timer = 0, idx = 0, current = '';
  function place(word: HTMLElement) {
    const rects = word.getClientRects();
    const r = rects[0];
    pol.style.left = `${r.left + r.width / 2}px`;
    pol.style.top = `${r.top}px`;
  }
  function setImg(list: string[], i: number) { img.src = list[i % list.length]; }
  function start(word: HTMLElement) {
    const list = sets[word.dataset.set!];
    current = word.dataset.set!;
    pol.dataset.set = current;
    place(word);
    setImg(list, idx);
    pol.classList.add('on');
    clearInterval(timer);
    timer = window.setInterval(() => { idx++; setImg(list, idx); }, 260);
  }
  function stop() { clearInterval(timer); pol.classList.remove('on'); current = ''; }

  document.querySelectorAll<HTMLElement>('.w').forEach((word) => {
    if (canHover) {
      word.addEventListener('mouseenter', () => start(word));
      word.addEventListener('mouseleave', stop);
    } else {
      word.addEventListener('click', (e) => {
        e.preventDefault();
        if (current === word.dataset.set) { idx++; setImg(sets[current], idx); } else start(word);
      });
      document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.w')) stop(); });
    }
  });
  addEventListener('scroll', () => { if (current) stop(); }, { passive: true });

  // Copy email on click
  const mail = document.querySelector<HTMLAnchorElement>('.mail');
  if (mail && navigator.clipboard) {
    mail.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(mail.dataset.mail!);
        const t = mail.textContent;
        mail.textContent = 'Copied to your clipboard!';
        mail.classList.add('copied');
        setTimeout(() => { mail.textContent = t; mail.classList.remove('copied'); }, 1600);
      } catch { location.href = mail.href; }
    });
  }
</script>
